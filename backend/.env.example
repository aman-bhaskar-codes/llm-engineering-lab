# ─── Multi-Model LLM Configuration ───
# Gemini (cloud fallback) — get key from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-key-here"
MODEL_NAME="gemini-2.5-flash"

# Local LLM (Ollama) — primary inference
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL_NAME="qwen2.5:3b"

# ─── Database ───
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/structured_extraction_engine"

# ─── Redis (streaming buffer, cache, rate limiting) ───
REDIS_URL="redis://localhost:6379/0"

# ─── Authentication ───
JWT_SECRET="change-this-to-a-random-string-in-production"

# ─── Neo4j Graph Memory (Optional — system works without it) ───
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
