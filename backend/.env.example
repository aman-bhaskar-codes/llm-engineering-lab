# Supported Multi-Models: Gemini, Qwen (via Ollama), Phi (via Ollama)
GEMINI_API_KEY="your-gemini-key-here"
MODEL_NAME="gemini-2.5-flash"

# Database Configuration (PostgreSQL via asyncpg)
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/structured_extraction_engine"

# Memory & Coordination (Optional robust fail-open systems)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

REDIS_URL="redis://localhost:6379"

# Local LLM Default Configurations 
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL_NAME="qwen2.5:3b"
